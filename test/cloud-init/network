network:
  version: 2
  ethernets:
    public:
      match:
        macaddress: "00:00:00:00:00:00"
      set-name: public
      dhcp4: true
      dhcp6: false
      dhcp4-overrides:
        use-dns: false
      nameservers:
        search:
        - k8s.local
        addresses:
        - 8.8.8.8
    internal:
      match:
        macaddress: "00:00:00:00:00:00"
      set-name: internal
      dhcp4: false
      dhcp6: false
      addresses: []
